Bootstrap: docker
From: pytorch/pytorch:2.1.2-cuda12.1-cudnn8-runtime

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        git \
        wget \
        libglib2.0-0 \
        libgl1 \
        libglib2.0-0 \
        htop \
        libhdf5-dev \
        gcc \
        g++

    # this doesn't link properly if you install it with apt. idk why
    conda install -c conda-forge openmpi mpi4py

    # This is for infiniband and NCCL2 (distributed training stuff)
    wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/x86_64/cuda-keyring_1.1-1_all.deb && dpkg -i cuda-keyring_1.1-1_all.deb
    apt-get update
    apt-get install -y libibverbs-dev libnccl2 libnccl-dev
    rm -rf /var/lib/apt/lists/*

    # can unpin things as needed, but makes installation slower
    python3 -m pip install \
        accelerate==0.27.2 \
        avalanche-lib==0.4.0 \
        dash==2.15.0 \
        diffusers["torch"]==0.26.3 \
        gradio==3.50.2 \
        h5py==3.10.0 \
        jedi-language-server==0.41.2 \
        joblib==1.3.2 \
        jupyterlab==4.1.2 \
        jupyterlab-lsp==5.0.3 \
        lightning==2.2.0.post0 \
        matplotlib==3.8.3 \
        opencv-python==4.7.0.72 \
        optuna==3.5.0 \
        pandas==1.5.3 \
        plotly==5.19.0 \
        pycocotools==2.0.7 \
        pydmd==0.4.1.post2311 \
        python-lsp-server[all]==1.10.0 \
        PyWavelets==1.5.0 \
        ray[train,tune,default]==2.9.3 \
        sahi==0.11.15 \
        scikit-image==0.22.0 \
        scikit-learn==1.4.1.post1 \
        seaborn==0.13.2 \
        streamlit==1.31.1 \
        streamlit-elements==0.1.0 \
        timm==0.9.16 \
        torchmetrics==1.3.1 \
        transformers==4.38.1 \
        typeguard==4.0.0 \
        ultralytics==8.1.18 \
        umap-learn==0.5.5 \
        wandb==0.16.3
    
    # dask is cool, distributed PCA! 
    python3 -m pip install \
        --extra-index-url=https://pypi.nvidia.com \
        cudf-cu12 \
        dask-cudf-cu12 \
        cuml-cu12 \
        cugraph-cu12 \
        cuspatial-cu12 \
        cuproj-cu12 \
        cuxfilter-cu12 \
        cucim \
        pylibraft-cu12 \
        raft-dask-cu12 \
        nvidia-dali-cuda120
